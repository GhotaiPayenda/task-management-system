# Server
PORT=5000
NODE_ENV=development

# Client origin allowed by CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=task_management_system

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Optional bootstrap admin for `npm run db:init`.
# Leave blank to create accounts through the registration form.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
